        <mxCell id="RF9u3kN4PSYJTl319Eqk-68" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="This handles the real-time multi-device communication, including IoT sockets for sensors, WiFi PAN for audit and operational essential data, and CAN bus in parallel." vertex="1">
